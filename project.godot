config_version=5

[application]
config/name="이웃 경매판"
run/main_scene="res://main.tscn"
config/description="조건 카드를 맞추는 원형 경매 퍼즐"

[display]
window/size/viewport_width=900
window/size/viewport_height=840
window/size/window_width_override=900
window/size/window_height_override=840
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[input]
ui_cancel={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
